[Unit]
Description=muse-bridge OpenAI-compatible API + consumer hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# TEMPLATE — the values below are Ubuntu-cloud defaults. Prefer installing
# via `sudo ./scripts/install-service.sh`, which rewrites User, the
# /home/ubuntu/muse-bridge paths, and ExecStart's bun path for this machine.
# A wrong User= makes systemd fail with status=217/USER.
User=ubuntu
WorkingDirectory=/home/ubuntu/muse-bridge
Environment=NODE_ENV=production
Environment=DB_PATH=/home/ubuntu/muse-bridge/data/bridge.db
Environment=HOST=127.0.0.1
Environment=PORT=8765
Environment=HUB_HOST=127.0.0.1
Environment=HUB_PORT=8767
# Adjust the bun path to `which bun` output on this host.
ExecStart=/usr/local/bin/bun src/cli.ts serve
Restart=always
RestartSec=2

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# must exist before start: sudo mkdir -p <this-dir>
ReadWritePaths=/home/ubuntu/muse-bridge/data

[Install]
WantedBy=multi-user.target
